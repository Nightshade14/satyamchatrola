---
// care-companion: serving architecture (left) and drift monitor (right). Illustrative, no real data.
// The drift monitor keeps its own coordinates and is moved beside the architecture with one translate.
---
<svg viewBox="0 4 400 112" preserveAspectRatio="xMidYMid meet" data-motion>
  <!-- Motion: the clip rect grows left to right to draw the drift line, in the drift monitor's coordinates. -->
  <clipPath id="drift-wipe"><rect class="wipe" x="10" y="130" width="180" height="70" /></clipPath>
  <g font-size="8" fill="currentColor">
    <text x="46" y="22">requests</text>
    <text x="48" y="59">metrics</text>
    <text x="104" y="108">p90 250 ms</text>
  </g>
  <line x1="40" y1="12" x2="40" y2="28" stroke="currentColor" stroke-width="1" />
  <path d="M36.5 25 L40 30 L43.5 25" fill="none" stroke="currentColor" stroke-width="1" />
  <rect x="10" y="30" width="60" height="20" fill="#F3EEE3" stroke="currentColor" stroke-width="1.2" />
  <text x="40" y="43" text-anchor="middle" font-size="8" fill="currentColor">FastAPI</text>
  <line x1="70" y1="40" x2="90" y2="40" stroke="currentColor" stroke-width="1" />
