  <text x="104" y="82" text-anchor="middle" font-size="8" fill="currentColor">GPU</text>
  <text x="104" y="92" text-anchor="middle" font-size="8" fill="currentColor">TensorRT</text>
  <rect x="136" y="70" width="56" height="28" fill="#F3EEE3" stroke="currentColor" stroke-width="1.2" />
  <text x="164" y="82" text-anchor="middle" font-size="8" fill="currentColor">CPU</text>
  <text x="164" y="92" text-anchor="middle" font-size="8" fill="currentColor">OpenVINO</text>
  <path d="M108 50 L108 64 L40 64 L40 70" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 2" />
  <rect x="10" y="70" width="60" height="28" fill="url(#cross)" stroke="currentColor" stroke-width="1.2" />
  <rect x="14" y="78" width="52" height="12" fill="#F3EEE3" />
