  <path d="M40 98 L40 112 L200 112 L200 16 L212 16" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 2" />
  <g transform="translate(204 -100)">
    <g font-size="8" fill="currentColor">
      <text x="58" y="128">· drift</text>
      <text x="12" y="146">threshold</text>
      <text x="162" y="136">alert</text>
    </g>
    <line x1="10" y1="116" x2="190" y2="116" stroke="currentColor" stroke-width="0.8" />
    <text x="10" y="128" font-size="8" fill="currentColor" opacity="0.7">Grafana</text>
    <line x1="10" y1="150" x2="190" y2="150" stroke="currentColor" stroke-width="1" stroke-dasharray="4 3" />
