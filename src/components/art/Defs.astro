---
// Engraving patterns and the star symbol, referenced by every inline SVG on the page.
---
<svg class="defs" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="h45" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="#1F3E94" stroke-width="0.9" /></pattern>
    <pattern id="h45d" width="2.8" height="2.8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="2.8" stroke="#1F3E94" stroke-width="1" /></pattern>
    <pattern id="h135" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)"><line x1="0" y1="0" x2="0" y2="4" stroke="#1F3E94" stroke-width="0.8" /></pattern>
    <pattern id="cross" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><path d="M0 0V4M0 0H4" stroke="#1F3E94" stroke-width="0.8" /></pattern>
    <pattern id="sea" width="10" height="5" patternUnits="userSpaceOnUse"><line x1="0" y1="2.5" x2="10" y2="2.5" stroke="#1F3E94" stroke-width="0.7" /></pattern>
    <pattern id="dots" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="0.7" fill="#1F3E94" /></pattern>
    <pattern id="creamHatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="#F3EEE3" stroke-width="0.9" /></pattern>
    <symbol id="star" viewBox="0 0 24 24"><path d="M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z" fill="currentColor" /><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.2" /></symbol>
  </defs>
</svg>
