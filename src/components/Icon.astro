---
// Inlines a Phosphor (regular) icon at build time, so no icon font or CDN loads at runtime.
import arrowDown from '@phosphor-icons/core/assets/regular/arrow-down.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import cpu from '@phosphor-icons/core/assets/regular/cpu.svg?raw';
import filePdf from '@phosphor-icons/core/assets/regular/file-pdf.svg?raw';
import filePy from '@phosphor-icons/core/assets/regular/file-py.svg?raw';
import fileText from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import fire from '@phosphor-icons/core/assets/regular/fire.svg?raw';
import githubLogo from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import linkedinLogo from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import magnifyingGlass from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import notebook from '@phosphor-icons/core/assets/regular/notebook.svg?raw';
import packageIcon from '@phosphor-icons/core/assets/regular/package.svg?raw';
import quotes from '@phosphor-icons/core/assets/regular/quotes.svg?raw';
import shieldCheck from '@phosphor-icons/core/assets/regular/shield-check.svg?raw';
import star from '@phosphor-icons/core/assets/regular/star.svg?raw';

const icons = {
  'arrow-down': arrowDown,
  'arrow-up-right': arrowUpRight,
  cpu,
  'file-pdf': filePdf,
  'file-py': filePy,
  'file-text': fileText,
  fire,
  'github-logo': githubLogo,
  'linkedin-logo': linkedinLogo,
  'magnifying-glass': magnifyingGlass,
  notebook,
  package: packageIcon,
  quotes,
  'shield-check': shieldCheck,
  star,
};
export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: extra } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg class="icon${extra ? ` ${extra}` : ''}" aria-hidden="true" focusable="false" `);
---
<Fragment set:html={svg} />
