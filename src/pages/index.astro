---
import Base from '../layouts/Base.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import HeroGpu from '../components/art/HeroGpu.astro';
import Ornament from '../components/art/Ornament.astro';
import InferenceDiagram from '../components/art/InferenceDiagram.astro';
import ReliabilityDiagram from '../components/art/ReliabilityDiagram.astro';
import EvalsDiagram from '../components/art/EvalsDiagram.astro';
import CareCompanionDiagram from '../components/art/CareCompanionDiagram.astro';
import CtaClouds from '../components/art/CtaClouds.astro';
import FooterCoast from '../components/art/FooterCoast.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const RESUME = `${base}/pdf/Satyam_Chandrakant_Chatrola_Resume.pdf`;
const PAPER_PDF = `${base}/pdf/satyam-chatrola-research-paper.pdf`;
const PAPER_URL =
  'https://www.researchgate.net/publication/388835538_Benchmarking_Fine-Tuned_Transformers_LLMs_and_LSTM_Networks_for_Automated_Essay_Scoring';
const LINKEDIN = 'https://www.linkedin.com/in/satyamchatrola';

type Pillar = 'Inference' | 'Reliability' | 'Retrieval';
const pillarIcon: Record<Pillar, IconName> = {
  Inference: 'cpu',
  Reliability: 'shield-check',
  Retrieval: 'magnifying-glass',
};

// The ticker tape under the hero repeats this sentence, one token per box.
const tapeSentence = ['Serve', ' every', ' token', ' fast', ',', ' keep', ' the', ' service', ' up', ',', ' and', ' measure', ' that', ' each', ' answer', ' holds', ' up', '.', '⏎'];
const tape = [...tapeSentence, ...tapeSentence, ...tapeSentence];

const stats: { pillar: Pillar; value: string; label: string }[] = [
  { pillar: 'Inference', value: '71%', label: 'p99 latency cut in production' },
  { pillar: 'Reliability', value: '355 MB', label: 'Deploy image, down from 14 GB' },
  { pillar: 'Retrieval', value: '5M+', label: 'SKUs served by hybrid retrieval' },
  { pillar: 'Retrieval', value: '+34%', label: 'Click through rate lift' },
];

const pillars = [
  {
    name: 'Inference',
    Diagram: InferenceDiagram,
    body: 'Batching, KV cache reuse, quantization, and semantic caching, so the first token arrives sooner and every token after it costs less.',
  },
  {
    name: 'Reliability',
    Diagram: ReliabilityDiagram,
    body: 'Async load shedding, backpressure, and circuit breakers under heavy traffic, incident root cause work, and drift monitoring that catches a decaying model early.',
  },
  {
    name: 'Evals',
    Diagram: EvalsDiagram,
    body: 'I build the evals that decide which model ships: candidate models are tested against product criteria and performance, side by side, before one is chosen.',
  },
];

const skills = ['Python asyncio', 'vLLM', 'Docker', 'ArgoCD', 'FAISS'];

const highlights: { metric: string; text: string }[] = [
  { metric: 'Current', text: 'Building evals for model decisions: candidate models are tested against product criteria and performance before one is chosen.' },
  { metric: '71%', text: 'Cut p99 latency by moving blocking calls off the asyncio event loop, while keeping session order intact.' },
  { metric: 'Async', text: 'Kept throughput steady under heavy concurrent load with an async logging queue: watermark based load shedding and backpressure to reduce GIL contention.' },
  { metric: '<7 min', text: 'Rebuilt multi stage Docker builds. The image went from 14 GB to 355 MB, and PR to production went from 30 minutes to under 7.' },
  { metric: 'Root cause', text: 'Found a silent misrouting between builds that caused a production traffic skew during a Jenkins to ArgoCD migration. Engineering leadership recognized the fix.' },
  { metric: '$300K+', text: 'Built hybrid retrieval (two tower network, FAISS, and BM25) over 5M+ SKUs. Conversion rose 7.2% and click through rose 34%, driving $300K+ ARR.' },
];

type Project = { name: string; url: string; tag: string; desc: string; lang: string; langIcon: IconName };

const featured: Project = {
  name: 'care-companion',
  url: 'https://github.com/care-ai-mlops/care-companion',
  tag: 'serving · Triton',
  desc: 'A production grade CNN inference service with P90 at 250 ms, on FastAPI and NVIDIA Triton. It runs GPU (TensorRT) and CPU (OpenVINO) backends, with Prometheus and Grafana to catch data drift and model decay in real time.',
  lang: 'Docker',
  langIcon: 'package',
};

const projects: Project[] = [
  { name: 'research-mate', url: 'https://github.com/Nightshade14/research-mate', tag: 'RAG · latency', desc: 'A contextual RAG research assistant on AWS. Binary quantized embeddings and an in memory vector store keep retrieval fast.', lang: 'Python', langIcon: 'file-py' },
  { name: 'vllm-demo', url: 'https://github.com/Nightshade14/vllm-demo', tag: 'serving', desc: 'Reproducible LLM serving with vLLM, packaged in Docker images for portable, high throughput inference.', lang: 'Docker', langIcon: 'package' },
  { name: 'semantic_cache_and_RAG', url: 'https://github.com/Nightshade14/semantic_cache_and_RAG', tag: 'caching', desc: 'A semantic cache, vector store, and RAG on FAISS. Repeat questions with the same meaning come from cache, which cuts latency and cost.', lang: 'Notebook', langIcon: 'notebook' },
  { name: 'truss-demo', url: 'https://github.com/Nightshade14/truss-demo', tag: 'deployment', desc: 'Model packaging and deployment with Truss: a trained model becomes a served endpoint with very little glue code.', lang: 'Python', langIcon: 'file-py' },
  { name: 'my_LLM', url: 'https://github.com/Nightshade14/my_LLM', tag: 'from scratch', desc: 'A language model built from scratch in PyTorch, grown step by step toward current production architecture.', lang: 'PyTorch', langIcon: 'fire' },
  { name: 'my_micrograd', url: 'https://github.com/Nightshade14/my_micrograd', tag: 'foundations', desc: "A rebuild of Karpathy's micrograd, a tiny autograd engine, to learn backprop from first principles.", lang: 'Python', langIcon: 'file-py' },
];

const articles = [
  {
    title: "A Pragmatic Engineer's Guide to OOMs, NCCL, and Resilience in Large-Scale Training",
    desc: 'What breaks when training leaves a single GPU: memory blowups, collective communication failures, and the patterns that keep long runs alive.',
    url: 'https://satyamchatrola.substack.com/p/hyperscale-distributed-llm-training',
  },
  {
    title: 'The Transformer Architecture: A First-Principles Analysis from Self-Attention to KV Caching',
    desc: 'The transformer from self attention up to the KV cache: the mechanics that inference optimization is built on.',
    url: 'https://satyamchatrola.substack.com/p/from-tokens-to-text-deconstructing',
  },
];

const QUALCOMM_URL = 'https://www.qualcomm.com/developer/blog/2024/12/on-device-ai-builders-hackathon-qualcomm-lmstudio-microsoft';

const socials: { label: string; url: string; icon: IconName }[] = [
  { label: 'GitHub', url: 'https://github.com/Nightshade14', icon: 'github-logo' },
  { label: 'LinkedIn', url: LINKEDIN, icon: 'linkedin-logo' },
  { label: 'Résumé PDF', url: RESUME, icon: 'file-text' },
];

const navLinks = [
  { label: 'Work', href: '#work' },
  { label: 'Experience', href: '#experience' },
  { label: 'Writing', href: '#writing' },
];
---

<Base
  title="Satyam Chatrola, AI Systems Engineer for LLM inference, reliability, and evals"
  description="AI Systems Engineer at Mursion, specializing in LLM inference, reliability, and evals: low tail latency serving, systems that stay up under load, and measured model quality."
>
  <nav class="nav" aria-label="Primary">
    <a class="brand title-4" href="#top"><svg aria-hidden="true"><use href="#star" /></svg>Satyam Chatrola</a>
    <div class="nav-links caption-1">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={RESUME} target="_blank" rel="noopener">Résumé</a>
    </div>
    <a class="btn btn-sm button-sm nav-cta" href={LINKEDIN} target="_blank" rel="noopener"><Icon name="linkedin-logo" />Message me</a>
    <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet"><span></span><span></span></button>
  </nav>
  <div class="sheet heading-4" id="sheet">
    {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={RESUME} target="_blank" rel="noopener">Résumé</a>
    <a class="btn btn-primary button-md" href={LINKEDIN} target="_blank" rel="noopener"><Icon name="linkedin-logo" />Message me on LinkedIn</a>
  </div>

  <main id="main" tabindex="-1">
    <header class="hero shell" id="top">
      <div class="panel">
        <div class="panel-rule" aria-hidden="true"></div>
        <div class="plate" aria-hidden="true"><HeroGpu /></div>

        <div class="hero-copy">
          <div class="who caption-1" data-reveal>
            <img src={`${base}/images/satyam-avatar.jpg`} alt="Portrait of Satyam Chatrola" width="28" height="28" />
            <span>Satyam Chatrola</span><span class="faint who-sep">·</span><span class="dim who-role">AI Systems Engineer</span>
          </div>
          <h1 class="heading-1" data-reveal style="--d:80ms">I make LLMs fast,<br />reliable, and measured.</h1>
          <p class="sub body-3 dim" data-reveal style="--d:160ms">AI Systems Engineer at Mursion, specializing in LLM inference, reliability, and evals. I serve models with low tail latency, keep them up under load, and measure that their answers hold up.</p>
          <div class="ctas" data-reveal style="--d:240ms">
            <a class="btn btn-primary button-md" href={LINKEDIN} target="_blank" rel="noopener"><Icon name="linkedin-logo" />Message me on LinkedIn</a>
            <a class="text-link caption-1" href="#work">See selected work <Icon name="arrow-down" /></a>
          </div>
        </div>

        <div class="tape" aria-hidden="true">
          <div class="tape-track" id="tape">{tape.map((t) => <span class="tok caption-4">{t}</span>)}</div>
        </div>
        <p class="plate-cap caption-4">An inference engine, serving tokens in order.</p>
      </div>
    </header>

    <section class="block" style="padding-top:var(--s-600)" aria-label="Results">
      <div class="shell stats">
        {stats.map((s, i) => (
          <div class="card stat" data-reveal style={`--d:${i * 60}ms`}>
            <span class="ptag caption-4"><Icon name={pillarIcon[s.pillar]} />{s.pillar}</span>
            <div class="num">{s.value}</div>
            <p class="lbl caption-1 dim">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <Ornament />

    <section class="block" id="focus">
      <div class="shell">
        <div class="section-head" data-reveal>
          <span class="eyebrow caption-1"><svg aria-hidden="true"><use href="#star" /></svg>Three specialties</span>
          <h2 class="heading-3">Fast to answer,<br />hard to break, measured to be right</h2>
        </div>
        <div class="pillars">
          {pillars.map(({ name, Diagram, body }, i) => (
            <article class="card pillar" data-reveal style={`--d:${i * 60}ms`}>
              <div class="vig" aria-hidden="true"><Diagram /></div>
              <h3 class="heading-5">{name}</h3>
              <p class="body-6 dim">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="tagline" aria-label="Tagline">
      <div class="shell">
        <p class="heading-2" id="tagline">A model is only as good as its slowest response and its worst answer. I build for both.</p>
      </div>
    </section>

    <section class="block" id="experience">
      <div class="shell exp">
        <div class="exp-side" data-reveal>
          <span class="eyebrow caption-1"><svg aria-hidden="true"><use href="#star" /></svg>Experience</span>
          <h2 class="heading-4">Production work, measured</h2>
          <div class="role">
            <p class="title-3">AI Systems Engineer</p>
            <p class="body-6 dim">Mursion</p>
          </div>
          <p class="summary body-6 dim">My work sits where async systems, concurrency, and ML serving meet. I am going deeper into LLM serving: throughput, KV cache efficiency, and tail latency.</p>
          <div class="chips caption-4">{skills.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
        <div class="rows">
          {highlights.map((h) => (
            <div class="card row" data-reveal>
              <span class="metric">{h.metric}</span>
              <div>
                <p class="body-3 dim">{h.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Ornament />

    <section class="block" id="work">
      <div class="shell">
        <div class="section-head" data-reveal>
          <span class="eyebrow caption-1"><svg aria-hidden="true"><use href="#star" /></svg>Selected work</span>
          <h2 class="heading-3">Serving systems I built end to end</h2>
        </div>
        <div class="projects">
          <a class="card proj feature" href={featured.url} target="_blank" rel="noopener" data-reveal>
            <div class="proj-body">
              <div class="proj-top"><span class="tag caption-4">{featured.tag}</span><Icon name="arrow-up-right" class="go" /></div>
              <h3 class="title-2">{featured.name}</h3>
              <p class="body-6 dim">{featured.desc}</p>
              <div class="meta caption-4 faint">
                <span><Icon name={featured.langIcon} />{featured.lang}</span>
              </div>
            </div>
            <div class="vignette" aria-hidden="true"><CareCompanionDiagram /></div>
          </a>
          {projects.map((p, i) => (
            <a class="card proj" href={p.url} target="_blank" rel="noopener" data-reveal style={`--d:${(i % 3) * 60}ms`}>
              <div class="proj-top"><span class="tag caption-4">{p.tag}</span><Icon name="arrow-up-right" class="go" /></div>
              <h3 class="title-2">{p.name}</h3>
              <p class="body-6 dim">{p.desc}</p>
              <div class="meta caption-4 faint">
                <span><Icon name={p.langIcon} />{p.lang}</span>
              </div>
            </a>
          ))}
        </div>
        <a class="text-link caption-1 all" href="https://github.com/Nightshade14?tab=repositories" target="_blank" rel="noopener" data-reveal><Icon name="github-logo" />All repositories on GitHub <Icon name="arrow-up-right" /></a>
      </div>
    </section>

    <section class="block" id="writing">
      <div class="shell">
        <div class="section-head" data-reveal>
          <span class="eyebrow caption-1"><svg aria-hidden="true"><use href="#star" /></svg>Writing and research</span>
          <h2 class="heading-3">I explain how the stack works</h2>
        </div>
        <div class="writing">
          <article class="card paper" data-reveal>
            <div>
              <span class="tag caption-4">Evals · peer reviewed</span>
              <h3 class="heading-5">Benchmarking Fine-Tuned Transformers, LLMs and LSTM Networks for Automated Essay Scoring</h3>
              <p class="body-6 dim">How transformer fine tuning, LLMs, and recurrent baselines trade accuracy against scoring cost. The fine tuned approach beat prior benchmarks by 5.7%.</p>
            </div>
            <div class="paper-links">
              <a class="btn btn-sm button-sm" href={PAPER_URL} target="_blank" rel="noopener">Read on ResearchGate <Icon name="arrow-up-right" /></a>
              <a class="btn btn-sm button-sm" href={PAPER_PDF} target="_blank" rel="noopener"><Icon name="file-pdf" />PDF</a>
            </div>
          </article>
          {articles.map((a, i) => (
            <a class="card" href={a.url} target="_blank" rel="noopener" data-reveal style={`--d:${i * 60}ms`}>
              <span class="tag caption-4">Deep dive</span>
              <h3 class="title-2">{a.title}</h3>
              <p class="body-6 dim">{a.desc}</p>
              <span class="read caption-1">Read on Substack <Icon name="arrow-up-right" /></span>
            </a>
          ))}
          <a class="card quote" href={QUALCOMM_URL} target="_blank" rel="noopener" data-reveal>
            <Icon name="quotes" />
            <div>
              <p class="title-3">Quoted by name on the power efficiency of on device LLM inference.</p>
              <p class="body-6 faint">On Device AI Builders Hackathon · Qualcomm, LM Studio, and Microsoft, at NYU Tandon</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="block" style="padding-top:0">
      <div class="shell">
        <div class="final" data-reveal>
          <CtaClouds />
          <h2 class="heading-3">Hiring for inference, reliability, or evals work?</h2>
          <p class="body-3">Tell me about the team and the problem you want to solve.</p>
          <a class="btn button-md" href={LINKEDIN} target="_blank" rel="noopener"><Icon name="linkedin-logo" />Message me on LinkedIn</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <FooterCoast />
    <div class="shell foot">
      <span class="caption-1 faint">© 2026 Satyam Chatrola</span>
      <div class="socials">
        {socials.map((s) => (
          <a class="icon-btn" href={s.url} aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} /></a>
        ))}
      </div>
    </div>
  </footer>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Mobile menu: links stagger 60ms each, total capped at 400ms.
    const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
    const sheetLinks = [...document.querySelectorAll<HTMLAnchorElement>('#sheet a')];
    sheetLinks.forEach((a, i) => { a.style.transitionDelay = `${Math.min(i * 60, 400)}ms`; });
    const setMenu = (open: boolean) => {
      document.body.classList.toggle('menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    menuBtn.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
    sheetLinks.forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

    // Mark the section in view as current in the nav.
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href^="#"]')];
    const sectionObserver = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      navLinks.forEach((a) => a.setAttribute('aria-current', String(a.hash === `#${e.target.id}`)));
    }), { rootMargin: '-45% 0px -50% 0px' });
    navLinks.forEach((a) => {
      const section = document.getElementById(a.hash.slice(1));
      if (section) sectionObserver.observe(section);
    });

    // Tagline: words go from muted ink to full ink one at a time (rAF throttled scroll).
    const tagline = document.getElementById('tagline')!;
    tagline.innerHTML = tagline.innerHTML
      .split(/(<br\s*\/?>)/)
      .map((part) => part.startsWith('<br') ? part : part.split(' ').filter(Boolean)
        .map((w) => `<span class="w${/slowest|worst|both\./.test(w) ? ' accent' : ''}">${w}</span>`).join(' '))
      .join('');
    const words = [...tagline.querySelectorAll('.w')];
    if (!reduced) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = tagline.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(Math.max((vh * 0.85 - r.top) / (vh * 0.4 + r.height), 0), 1);
        const lit = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < lit));
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    }

    // Ticker tape: advance one token at a time on the base curve; idle while off screen.
    const track = document.getElementById('tape')!;
    if (!reduced) {
      let visible = true;
      let busy = false;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(track);
      const mark = () => {
        track.querySelector('.tok.hot')?.classList.remove('hot');
        const edge = track.parentElement!.getBoundingClientRect().right;
        const shown = [...track.children].filter((t) => t.getBoundingClientRect().right <= edge);
        shown.at(-1)?.classList.add('hot');
      };
      const step = () => {
        const first = track.firstElementChild;
        if (!visible || document.hidden || busy || !(first instanceof HTMLElement)) return;
        busy = true;
        const shift = first.getBoundingClientRect().width + 8;
        track.style.transition = 'transform 500ms cubic-bezier(0.22, 1, 0.36, 1)';
        track.style.transform = `translateX(${-shift}px)`;
        track.addEventListener('transitionend', () => {
          track.style.transition = 'none';
          track.append(first);
          track.style.transform = 'none';
          busy = false;
          mark();
        }, { once: true });
      };
      mark();
      setInterval(step, 900);
    }
  </script>
</Base>
